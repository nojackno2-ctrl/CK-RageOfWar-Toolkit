<?xml version="1.0" encoding="utf-8"?>
<!--
  CKPerf.vcxproj — the injected runtime diagnostic layer.

  Deliberately NOT part of CKToolkit.sln. The solution is built with `dotnet build`,
  which cannot build a vcxproj; adding it there would break the documented build
  command for everyone who never touches this DLL. CKToolkit.csproj builds it through
  tools/perf/build-ckperf.ps1 instead, and falls back to the checked-in binary under
  assets/ckperf/ when no MSVC toolset is installed.

  Win32 only, and that is not a preference: the target process is a 2004 32-bit build.
  Static CRT (/MT) so the injected DLL never needs a VC redist present in a process we
  do not control.
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|Win32">
      <Configuration>Debug</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{C7D9F1A4-6B23-4E58-9A0C-3D5E7F2B1948}</ProjectGuid>
    <RootNamespace>CKPerf</RootNamespace>
    <WindowsTargetPlatformVersion>$(LatestTargetPlatformVersion)</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <PlatformToolset>$(DefaultPlatformToolset)</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
    <WholeProgramOptimization Condition="'$(Configuration)'=='Release'">true</WholeProgramOptimization>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <PropertyGroup>
    <TargetName>ckperf</TargetName>
    <OutDir>$(MSBuildThisFileDirectory)..\..\dist\ckperf\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)obj\$(Configuration)\</IntDir>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <PreprocessorDefinitions>WIN32;_WINDOWS;_USRDLL;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- Static CRT: the DLL is injected into a process whose runtime dependencies we
           do not get to choose, so it must carry everything it needs. -->
      <RuntimeLibrary Condition="'$(Configuration)'=='Debug'">MultiThreadedDebug</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(Configuration)'=='Release'">MultiThreaded</RuntimeLibrary>
      <Optimization Condition="'$(Configuration)'=='Debug'">Disabled</Optimization>
      <Optimization Condition="'$(Configuration)'=='Release'">MaxSpeed</Optimization>
      <FunctionLevelLinking Condition="'$(Configuration)'=='Release'">true</FunctionLevelLinking>
      <IntrinsicFunctions Condition="'$(Configuration)'=='Release'">true</IntrinsicFunctions>
      <!-- Buffer security checks stay ON even in Release. This code runs inside a
           process that is already suspected of memory corruption; silently scribbling
           over our own stack would produce misleading crash reports. -->
      <BufferSecurityCheck>true</BufferSecurityCheck>
      <!-- Sources are UTF-8; without this the compiler reads them in the system
           code page (950 on this machine) and C4819 turns every file into an error. -->
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <EnableCOMDATFolding Condition="'$(Configuration)'=='Release'">true</EnableCOMDATFolding>
      <OptimizeReferences Condition="'$(Configuration)'=='Release'">true</OptimizeReferences>
      <AdditionalDependencies>kernel32.lib;user32.lib;gdi32.lib;shell32.lib;ole32.lib;dbghelp.lib;psapi.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClInclude Include="ckperf.h" />
    <ClCompile Include="arrayguard.cpp" />
    <ClCompile Include="common.cpp" />
    <ClCompile Include="crash.cpp" />
    <ClCompile Include="frames.cpp" />
    <ClCompile Include="guard.cpp" />
    <ClCompile Include="hires.cpp" />
    <ClCompile Include="nullstore.cpp" />
    <ClCompile Include="script.cpp" />
    <ClCompile Include="telemetry.cpp" />
    <ClCompile Include="vmlvalue.cpp" />
    <ClCompile Include="dllmain.cpp" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
