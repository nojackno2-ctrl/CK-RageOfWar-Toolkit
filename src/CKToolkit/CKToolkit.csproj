<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>CKToolkit</AssemblyName>
    <RootNamespace>CKToolkit</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Required by [LibraryImport] source generation (SYSLIB1062); the P/Invokes for
         AttachConsole and the profiler's Wow64 thread-context reads all go through it. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <AssemblyTitle>CK-RageOfWar Toolkit</AssemblyTitle>
    <Product>CK-RageOfWar Toolkit</Product>
    <Version>1.0.1</Version>

    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <ApplicationDefaultFont>Microsoft JhengHei UI, 9pt</ApplicationDefaultFont>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="I18n\strings.zh-TW.json" WithCulture="false" LogicalName="CKToolkit.I18n.strings.zh-TW.json" />
    <EmbeddedResource Include="I18n\strings.zh-CN.json" WithCulture="false" LogicalName="CKToolkit.I18n.strings.zh-CN.json" />
    <EmbeddedResource Include="I18n\strings.en.json" WithCulture="false" LogicalName="CKToolkit.I18n.strings.en.json" />
    <EmbeddedResource Include="..\..\assets\langpacks\**\*" WithCulture="false" LogicalName="CKToolkit.LangPacks.%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- The injected 32-bit diagnostic layer. Built separately by
         tools/perf/build-ckperf.ps1, because `dotnet build` cannot build a vcxproj;
         the result is checked in under assets/ so the C# build never needs MSVC. -->
    <EmbeddedResource Include="..\..\assets\ckperf\ckperf.dll" WithCulture="false" LogicalName="CKToolkit.Runtime.ckperf.dll" />
  </ItemGroup>

</Project>
